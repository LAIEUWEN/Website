# ---------------------------------------------------------------------------
# Copy this file to `.env.local` for local development, and add the same
# variables in Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- GitHub (Section 3: Live GitHub Activity) -------------------------------
# Optional override for the username in data/portfolioData.ts
GITHUB_USERNAME=

# Recommended. A fine-grained or classic Personal Access Token with NO scopes
# (public data only). Enables the GraphQL API for the real contribution
# calendar + pinned repositories and raises the rate limit to 5,000 req/hr.
# Without it the site falls back to the public REST API + a public
# contributions mirror. Create one at: https://github.com/settings/tokens
GITHUB_TOKEN=

# (GitHub data is re-fetched via ISR every hour — change GITHUB_REVALIDATE in
#  lib/github.ts and `revalidate` in app/page.tsx to adjust.)

# --- Contact form (Section 6) -----------------------------------------------
# Free access key from https://web3forms.com (sent to the email you register).
# It is safe to expose publicly — Web3Forms keys are designed for client-side use.
NEXT_PUBLIC_WEB3FORMS_KEY=
